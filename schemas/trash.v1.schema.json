{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/netsirius/rotten-apple/schemas/trash.v1.schema.json",
  "title": "rotten trash --json (schema_version 1)",
  "description": "rotten trash put <ruta…> (T-10): plan por selección explícita con su simulación (--dry-run) o con el informe de ejecución. O el documento de error común. Los $defs del plan y de los informes son copia de clean.v1.",
  "oneOf": [
    { "$ref": "#/$defs/dry_run" },
    { "$ref": "#/$defs/executed" },
    { "$ref": "#/$defs/error" }
  ],
  "$defs": {
    "count": { "type": "integer", "minimum": 0 },
    "int": { "type": "integer" },
    "path": { "type": "string", "minLength": 1 },
    "digest": { "type": "string", "pattern": "^blake3:[0-9a-f]{64}$" },
    "category_id": { "type": "string", "pattern": "^CAT-[0-9]{2}$" },
    "category": {
      "description": "Categoría del elemento: la del catálogo o «selection» si viene de una selección explícita.",
      "anyOf": [{ "$ref": "#/$defs/category_id" }, { "const": "selection" }]
    },
    "file_kind": { "enum": ["file", "dir", "symlink", "other"] },
    "flag_violation": { "enum": ["immutable", "append_only", "restricted", "no_unlink", "firmlink", "dataless"] },

    "dry_run": {
      "type": "object",
      "required": ["schema_version", "command", "action", "dry_run", "plan", "preview"],
      "additionalProperties": false,
      "properties": {
        "schema_version": { "const": 1 },
        "command": { "const": "trash" },
        "action": { "const": "put" },
        "dry_run": { "const": true },
        "plan": { "$ref": "#/$defs/plan" },
        "preview": { "$ref": "#/$defs/exec_report" }
      }
    },
    "executed": {
      "type": "object",
      "required": ["schema_version", "command", "action", "dry_run", "plan", "report"],
      "additionalProperties": false,
      "properties": {
        "schema_version": { "const": 1 },
        "command": { "const": "trash" },
        "action": { "const": "put" },
        "dry_run": { "const": false },
        "plan": { "$ref": "#/$defs/plan" },
        "report": { "$ref": "#/$defs/exec_report" }
      }
    },

    "plan": {
      "description": "Documento de plan (rotten.plan.v1) tal como lo serializa ra-plan; su hash se verifica al ejecutar.",
      "type": "object",
      "required": [
        "schema", "schema_version", "plan_id", "created_at", "catalog_version", "origin", "home",
        "action", "items", "skipped", "not_selected", "totals", "plan_hash"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": { "const": "rotten.plan.v1" },
        "schema_version": { "const": 1 },
        "plan_id": { "type": "string", "minLength": 1 },
        "created_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$" },
        "catalog_version": { "type": "string" },
        "origin": { "enum": ["rules", "explicit_selection"] },
        "home": { "$ref": "#/$defs/path" },
        "action": { "enum": ["trash", "delete"] },
        "items": { "type": "array", "items": { "$ref": "#/$defs/plan_item" } },
        "skipped": { "type": "array", "items": { "$ref": "#/$defs/skipped" } },
        "not_selected": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/category_id" },
          "additionalProperties": {
            "type": "object",
            "required": ["items", "bytes_allocated"],
            "additionalProperties": false,
            "properties": {
              "items": { "$ref": "#/$defs/count" },
              "bytes_allocated": { "$ref": "#/$defs/count" }
            }
          }
        },
        "totals": {
          "type": "object",
          "required": ["items", "bytes_allocated", "irreversible_items"],
          "additionalProperties": false,
          "properties": {
            "items": { "$ref": "#/$defs/count" },
            "bytes_allocated": { "$ref": "#/$defs/count" },
            "irreversible_items": { "$ref": "#/$defs/count" }
          }
        },
        "plan_hash": { "$ref": "#/$defs/digest" }
      }
    },
    "rule_ref": {
      "type": "object",
      "required": ["id", "version"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "$ref": "#/$defs/count" }
      }
    },
    "identity": {
      "type": "object",
      "required": ["dev", "ino", "kind", "size", "mtime", "mtime_nsec", "ctime", "ctime_nsec"],
      "additionalProperties": false,
      "properties": {
        "dev": { "$ref": "#/$defs/count" },
        "ino": { "$ref": "#/$defs/count" },
        "kind": { "$ref": "#/$defs/file_kind" },
        "size": { "$ref": "#/$defs/count" },
        "mtime": { "$ref": "#/$defs/int" },
        "mtime_nsec": { "$ref": "#/$defs/int" },
        "ctime": { "$ref": "#/$defs/int" },
        "ctime_nsec": { "$ref": "#/$defs/int" }
      }
    },
    "fingerprint": {
      "type": "object",
      "required": ["entries", "bytes_allocated", "bytes_logical", "newest_mtime", "crosses_device", "digest"],
      "additionalProperties": false,
      "properties": {
        "entries": { "$ref": "#/$defs/count" },
        "bytes_allocated": { "$ref": "#/$defs/count" },
        "bytes_logical": { "$ref": "#/$defs/count" },
        "newest_mtime": { "$ref": "#/$defs/int" },
        "crosses_device": { "type": "boolean" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "plan_item": {
      "type": "object",
      "required": [
        "item_id", "path", "kind", "identity", "fingerprint", "bytes_allocated", "rule", "category",
        "risk", "regenerable", "preselected", "action", "reversible", "apps"
      ],
      "additionalProperties": false,
      "properties": {
        "item_id": { "type": "integer", "minimum": 1 },
        "path": { "$ref": "#/$defs/path" },
        "kind": { "$ref": "#/$defs/file_kind" },
        "identity": { "$ref": "#/$defs/identity" },
        "fingerprint": { "$ref": "#/$defs/fingerprint" },
        "bytes_allocated": { "$ref": "#/$defs/count" },
        "rule": { "$ref": "#/$defs/rule_ref" },
        "category": { "$ref": "#/$defs/category" },
        "risk": { "enum": ["safe", "caution", "review"] },
        "regenerable": { "type": "boolean" },
        "preselected": { "type": "boolean" },
        "action": { "enum": ["trash", "delete"] },
        "reversible": { "type": "boolean" },
        "apps": { "type": "array", "items": { "type": "string" } },
        "origin": {
          "description": "Se omite cuando es «rules» (los planes del catálogo no cambian ni su hash).",
          "enum": ["rules", "explicit_selection"]
        }
      }
    },
    "skipped": {
      "type": "object",
      "required": ["path", "rule", "category", "reason"],
      "additionalProperties": false,
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "rule": { "$ref": "#/$defs/rule_ref" },
        "category": { "$ref": "#/$defs/category" },
        "reason": { "$ref": "#/$defs/skip_reason" }
      }
    },
    "skip_reason": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "detail"],
          "additionalProperties": false,
          "properties": { "kind": { "const": "blocked" }, "detail": { "$ref": "#/$defs/block" } }
        },
        {
          "type": "object",
          "required": ["kind", "detail"],
          "additionalProperties": false,
          "properties": { "kind": { "const": "protected" }, "detail": { "$ref": "#/$defs/protection_reason" } }
        },
        {
          "type": "object",
          "required": ["kind", "detail"],
          "additionalProperties": false,
          "properties": { "kind": { "const": "excluded" }, "detail": { "$ref": "#/$defs/exclusion_match" } }
        },
        {
          "type": "object",
          "required": ["kind", "detail"],
          "additionalProperties": false,
          "properties": { "kind": { "const": "overlaps" }, "detail": { "$ref": "#/$defs/path" } }
        }
      ]
    },
    "block": {
      "description": "Por qué un candidato no entra en el plan. «running» y «unknown» son el AppBlock aplanado: la clave «kind» de «app» se pierde (anotado para T-03).",
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "min_age_days", "age_days"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "too_recent" },
            "min_age_days": { "$ref": "#/$defs/count" },
            "age_days": { "$ref": "#/$defs/int" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "bundle_id"],
          "additionalProperties": false,
          "properties": { "kind": { "const": "running" }, "bundle_id": { "type": "string" } }
        },
        {
          "type": "object",
          "required": ["kind", "detail"],
          "additionalProperties": false,
          "properties": { "kind": { "const": "unknown" }, "detail": { "type": "string" } }
        },
        {
          "type": "object",
          "required": ["kind", "flag"],
          "additionalProperties": false,
          "properties": { "kind": { "const": "flags" }, "flag": { "$ref": "#/$defs/flag_violation" } }
        },
        {
          "type": "object",
          "required": ["kind", "name"],
          "additionalProperties": false,
          "properties": { "kind": { "const": "contains_never_name" }, "name": { "type": "string" } }
        },
        {
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": { "kind": { "const": "crosses_device" } }
        },
        {
          "type": "object",
          "required": ["kind", "detail"],
          "additionalProperties": false,
          "properties": { "kind": { "const": "unreadable" }, "detail": { "type": "string" } }
        }
      ]
    },
    "protection_reason": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "inside_protected", "ancestor_of_protected", "user_folder", "home", "volume_root",
            "app_state", "protected_bundle", "invalid_path", "outside_home"
          ]
        },
        "root": { "$ref": "#/$defs/path" },
        "detail": { "type": "string" }
      }
    },
    "exclusion_match": {
      "type": "object",
      "required": ["kind", "value"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": ["path", "contains_excluded_path", "glob", "contains_glob_match", "rule", "category", "bundle_id"]
        },
        "value": { "type": "string" }
      }
    },
    "app_block": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["running", "unknown"] },
        "bundle_id": { "type": "string" },
        "detail": { "type": "string" }
      }
    },
    "in_use_detail": {
      "description": "Detalle del motivo «in_use» (RF-SEG-08): el proceso que lo tiene abierto o, si no se pudo saber, por qué.",
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "pid", "process"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "held" },
            "pid": { "type": "integer" },
            "process": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "detail"],
          "additionalProperties": false,
          "properties": { "kind": { "const": "unknown" }, "detail": { "type": "string" } }
        }
      ]
    },

    "exec_report": {
      "type": "object",
      "required": ["dry_run", "items", "done", "would", "skipped", "failed", "bytes_done"],
      "additionalProperties": false,
      "properties": {
        "op_id": { "type": "string", "minLength": 1 },
        "dry_run": { "type": "boolean" },
        "items": { "type": "array", "items": { "$ref": "#/$defs/item_report" } },
        "done": { "$ref": "#/$defs/count" },
        "would": { "$ref": "#/$defs/count" },
        "skipped": { "$ref": "#/$defs/count" },
        "failed": { "$ref": "#/$defs/count" },
        "bytes_done": { "$ref": "#/$defs/count" }
      }
    },
    "item_report": {
      "type": "object",
      "required": ["item_id", "path", "bytes", "outcome"],
      "properties": {
        "item_id": { "type": "integer", "minimum": 1 },
        "path": { "$ref": "#/$defs/path" },
        "bytes": { "$ref": "#/$defs/count" }
      },
      "oneOf": [
        {
          "properties": {
            "outcome": { "const": "done" },
            "result_path": { "$ref": "#/$defs/path" },
            "post_check": { "type": "string" }
          }
        },
        {
          "required": ["action"],
          "properties": {
            "outcome": { "const": "would" },
            "action": { "enum": ["would_trash", "would_delete", "would_restore"] }
          }
        },
        {
          "required": ["reason", "message"],
          "properties": {
            "outcome": { "const": "skipped" },
            "reason": {
              "enum": [
                "missing", "symlink_in_path", "identity_changed", "contents_changed", "flags",
                "crosses_device", "protected", "excluded", "app", "unreadable", "conflict_exists",
                "in_use"
              ]
            },
            "message": { "type": "string" },
            "flag": { "$ref": "#/$defs/flag_violation" },
            "detail": {
              "anyOf": [
                { "type": "string" },
                { "$ref": "#/$defs/protection_reason" },
                { "$ref": "#/$defs/exclusion_match" },
                { "$ref": "#/$defs/app_block" },
                { "$ref": "#/$defs/in_use_detail" }
              ]
            }
          }
        },
        {
          "required": ["error"],
          "properties": {
            "outcome": { "const": "failed" },
            "error": { "type": "string" }
          }
        }
      ],
      "unevaluatedProperties": false
    },

    "error": {
      "type": "object",
      "required": ["schema_version", "command", "error"],
      "additionalProperties": false,
      "properties": {
        "schema_version": { "const": 1 },
        "command": { "const": "trash" },
        "error": {
          "type": "object",
          "required": ["exit_code", "message"],
          "additionalProperties": false,
          "properties": {
            "exit_code": { "enum": [1, 2, 3, 4, 5, 6] },
            "message": { "type": "string" }
          }
        }
      }
    }
  }
}
