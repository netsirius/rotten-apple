{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/netsirius/rotten-apple/schemas/scan.v1.schema.json",
  "title": "rotten scan --json (schema_version 1)",
  "description": "Resumen del escaneo por categoría (RF-PAN-02, RF-PAN-03). O el documento de error común.",
  "oneOf": [
    { "$ref": "#/$defs/report" },
    { "$ref": "#/$defs/error" }
  ],
  "$defs": {
    "count": { "type": "integer", "minimum": 0 },
    "path": { "type": "string", "minLength": 1 },
    "scan_status": { "enum": ["complete", "partial", "unavailable"] },
    "report": {
      "type": "object",
      "required": ["schema_version", "command", "scan_status", "catalog_version", "categories", "config", "home"],
      "additionalProperties": false,
      "properties": {
        "schema_version": { "const": 1 },
        "command": { "const": "scan" },
        "scan_status": { "$ref": "#/$defs/scan_status" },
        "catalog_version": { "type": "string" },
        "categories": { "type": "array", "items": { "$ref": "#/$defs/category" } },
        "config": { "enum": ["missing", "ok", "corrupt"] },
        "warnings": { "type": "array", "items": { "type": "string" } },
        "home": { "$ref": "#/$defs/path" }
      }
    },
    "category": {
      "type": "object",
      "required": [
        "id", "title_es", "title_en", "scan_status", "items", "bytes_allocated",
        "preselected_items", "preselected_bytes", "skipped_items", "requires"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^CAT-[0-9]{2}$" },
        "title_es": { "type": "string" },
        "title_en": { "type": "string" },
        "scan_status": { "$ref": "#/$defs/scan_status" },
        "items": { "$ref": "#/$defs/count" },
        "bytes_allocated": { "$ref": "#/$defs/count" },
        "preselected_items": { "$ref": "#/$defs/count" },
        "preselected_bytes": { "$ref": "#/$defs/count" },
        "skipped_items": { "$ref": "#/$defs/count" },
        "requires": { "type": "array", "items": { "enum": ["fda"] } },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "error": {
      "type": "object",
      "required": ["schema_version", "command", "error"],
      "additionalProperties": false,
      "properties": {
        "schema_version": { "const": 1 },
        "command": { "const": "scan" },
        "error": {
          "type": "object",
          "required": ["exit_code", "message"],
          "additionalProperties": false,
          "properties": {
            "exit_code": { "enum": [1, 2, 3, 4, 5, 6] },
            "message": { "type": "string" }
          }
        }
      }
    }
  }
}
